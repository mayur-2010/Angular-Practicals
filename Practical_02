// app.component.html
<div class="timetable-wrapper">
  <header class="header">
    <h2>{{ college }}</h2>
    <h4>{{ department }}</h4>
    <p class="batch">{{ classTitle }}</p>
  </header>

  <!-- Day Selection Tabs (Event Binding) -->
  <div class="day-tabs">
    <button
      *ngFor="let day of days"
      (click)="selectDay(day)"
      [class.active]="selectedDay === day"
      class="tab-btn">
      {{ day }}
    </button>
  </div>

  <!-- Timetable Table Showcase (Data Binding) -->
  <div class="table-container">
    <h3>Schedule for: <span>{{ selectedDay }}</span></h3>
    <table class="timetable-table">
      <thead>
        <tr>
          <th>Time Slot</th>
          <th>Subject / Event</th>
          <th>Instructor</th>
          <th>Venue / Room</th>
          <th>Session Type</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let item of schedule[selectedDay]" [class.break-row]="item.type === 'Break'">
          <td class="time-cell">{{ item.time }}</td>
          <td class="subject-cell"><strong>{{ item.subject }}</strong></td>
          <td>{{ item.teacher }}</td>
          <td>{{ item.room }}</td>
          <td>
            <span class="badge" [ngClass]="item.type.toLowerCase()">
              {{ item.type }}
            </span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

// app.component.css
.timetable-wrapper {
  max-width: 900px;
  margin: 30px auto;
  padding: 24px;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}

.header {
  text-align: center;
  border-bottom: 2px solid #eaedf3;
  padding-bottom: 16px;
  margin-bottom: 20px;
}

.header h2 {
  color: #1a365d;
  margin: 0 0 6px 0;
}

.header h4 {
  color: #4a5568;
  margin: 0 0 6px 0;
}

.batch {
  color: #718096;
  font-weight: 500;
  margin: 0;
}

.day-tabs {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-bottom: 24px;
}

.tab-btn {
  padding: 8px 18px;
  border: 1px solid #cbd5e0;
  background-color: #f7fafc;
  color: #4a5568;
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-btn:hover {
  background-color: #edf2f7;
}

.tab-btn.active {
  background-color: #3182ce;
  color: white;
  border-color: #3182ce;
  box-shadow: 0 2px 8px rgba(49, 130, 206, 0.35);
}

.table-container h3 {
  color: #2d3748;
  margin-bottom: 14px;
}

.table-container h3 span {
  color: #3182ce;
}

.timetable-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.timetable-table th {
  background-color: #2b6cb0;
  color: white;
  padding: 12px 14px;
  font-weight: 600;
}

.timetable-table td {
  padding: 12px 14px;
  border-bottom: 1px solid #e2e8f0;
  color: #2d3748;
}

.timetable-table tbody tr:hover {
  background-color: #f7fafc;
}

.break-row {
  background-color: #fffaf0 !important;
  font-style: italic;
}

.badge {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: bold;
}

.badge.theory {
  background-color: #e2e8f0;
  color: #2d3748;
}

.badge.lab {
  background-color: #c6f6d5;
  color: #22543d;
}

.badge.break {
  background-color: #feebc8;
  color: #744210;
}