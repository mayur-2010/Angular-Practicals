// Practical 13: Calculator – Basic arithmetic operations using React

// App.jsx
import React, { useState } from 'react';
import './App.css';

function App() {
  const [input, setInput] = useState('0');
  const [prevOperation, setPrevOperation] = useState('');

  const handleNumber = (value) => {
    if (input === '0' || input === 'Error') {
      setInput(value);
    } else {
      setInput(input + value);
    }
  };

  const handleOperator = (op) => {
    if (input === 'Error') return;
    const lastChar = input.slice(-1);
    if (['+', '-', '*', '/', '%'].includes(lastChar)) {
      setInput(input.slice(0, -1) + op);
    } else {
      setInput(input + op);
    }
  };

  const handleDecimal = () => {
    if (input === 'Error') return;
    const parts = input.split(/[\+\-\*\/%]/);
    const lastPart = parts[parts.length - 1];
    if (!lastPart.includes('.')) {
      setInput(input + '.');
    }
  };

  const handleClear = () => {
    setInput('0');
    setPrevOperation('');
  };

  const handleDelete = () => {
    if (input === 'Error' || input.length === 1) {
      setInput('0');
    } else {
      setInput(input.slice(0, -1));
    }
  };

  const handleCalculate = () => {
    try {
      // Evaluate basic arithmetic expression safely
      // Replace % with /100 for percentage calculation if needed
      const sanitized = input.replace(/%/g, '/100');
      // eslint-disable-next-line no-eval
      const result = Function(`'use strict'; return (${sanitized})`)();
      
      if (!isFinite(result) || isNaN(result)) {
        setInput('Error');
      } else {
        // Round floating point precision issues
        const formatted = Math.round(result * 100000000) / 100000000;
        setPrevOperation(`${input} =`);
        setInput(formatted.toString());
      }
    } catch {
      setInput('Error');
    }
  };

  return (
    <div className="calculator-container">
      <div className="calculator">
        <div className="display">
          <div className="prev-operation">{prevOperation}</div>
          <div className="current-input">{input}</div>
        </div>

        <div className="keypad">
          <button className="btn func" onClick={handleClear}>AC</button>
          <button className="btn func" onClick={handleDelete}>DEL</button>
          <button className="btn func" onClick={() => handleOperator('%')}>%</button>
          <button className="btn op" onClick={() => handleOperator('/')}>÷</button>

          <button className="btn num" onClick={() => handleNumber('7')}>7</button>
          <button className="btn num" onClick={() => handleNumber('8')}>8</button>
          <button className="btn num" onClick={() => handleNumber('9')}>9</button>
          <button className="btn op" onClick={() => handleOperator('*')}>×</button>

          <button className="btn num" onClick={() => handleNumber('4')}>4</button>
          <button className="btn num" onClick={() => handleNumber('5')}>5</button>
          <button className="btn num" onClick={() => handleNumber('6')}>6</button>
          <button className="btn op" onClick={() => handleOperator('-')}>−</button>

          <button className="btn num" onClick={() => handleNumber('1')}>1</button>
          <button className="btn num" onClick={() => handleNumber('2')}>2</button>
          <button className="btn num" onClick={() => handleNumber('3')}>3</button>
          <button className="btn op" onClick={() => handleOperator('+')}>+</button>

          <button className="btn num zero" onClick={() => handleNumber('0')}>0</button>
          <button className="btn num" onClick={handleDecimal}>.</button>
          <button className="btn equals" onClick={handleCalculate}>=</button>
        </div>
      </div>
    </div>
  );
}

export default App;

