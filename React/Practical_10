// Practical 10: Build Hello World React App

// App.jsx
import React, { useState } from 'react';
import './App.css';

function App() {
  const [userName, setUserName] = useState('');

  return (
    <div className="container">
      <div className="card">
        <div className="react-logo">⚛️</div>
        <h1>Hello, World!</h1>
        <p className="subtitle">Welcome to React Development (FSD-III Lab)</p>

        <div className="input-box">
          <input
            type="text"
            placeholder="Enter your name..."
            value={userName}
            onChange={(e) => setUserName(e.target.value)}
          />
        </div>

        {userName && (
          <h2 className="greeting">
            Hello, <span className="highlight">{userName}</span>! 👋
          </h2>
        )}

        <div className="footer-tag">
          <span>React 18 / 19</span> • <span>Vite</span> • <span>Modern UI</span>
        </div>
      </div>
    </div>
  );
}

export default App;

