// Practical 14: Digital Clock – Display live time and date using React

// App.jsx
import React, { useState, useEffect } from 'react';
import './App.css';

function App() {
  const [time, setTime] = useState(new Date());
  const [is24Hour, setIs24Hour] = useState(false);

  useEffect(() => {
    // Update every second
    const timerId = setInterval(() => {
      setTime(new Date());
    }, 1000);

    // Cleanup interval on unmount
    return () => clearInterval(timerId);
  }, []);

  // Format Hours
  let hours = time.getHours();
  const ampm = hours >= 12 ? 'PM' : 'AM';

  if (!is24Hour) {
    hours = hours % 12 || 12;
  }

  const formatWithZero = (num) => num.toString().padStart(2, '0');

  const formattedHours = formatWithZero(hours);
  const formattedMinutes = formatWithZero(time.getMinutes());
  const formattedSeconds = formatWithZero(time.getSeconds());

  // Format Date
  const dateOptions = {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  };
  const formattedDate = time.toLocaleDateString(undefined, dateOptions);

  return (
    <div className="clock-wrapper">
      <div className="clock-card">
        <h2 className="clock-title">React Digital Clock</h2>

        {/* Date Display */}
        <div className="date-display">
          📅 {formattedDate}
        </div>

        {/* Digital Time Digits */}
        <div className="time-display">
          <div className="time-unit">
            <span className="digit">{formattedHours}</span>
            <span className="unit-label">HOURS</span>
          </div>
          <span className="separator">:</span>
          <div className="time-unit">
            <span className="digit">{formattedMinutes}</span>
            <span className="unit-label">MINUTES</span>
          </div>
          <span className="separator">:</span>
          <div className="time-unit">
            <span className="digit">{formattedSeconds}</span>
            <span className="unit-label">SECONDS</span>
          </div>

          {!is24Hour && (
            <div className="ampm-badge">
              {ampm}
            </div>
          )}
        </div>

        {/* Format Toggle Button */}
        <div className="controls">
          <button
            className="toggle-btn"
            onClick={() => setIs24Hour(!is24Hour)}
          >
            Switch to {is24Hour ? '12-Hour' : '24-Hour'} Format
          </button>
        </div>

        <div className="clock-footer">
          Real-time updates via <code>useEffect</code> &amp; <code>setInterval</code>
        </div>
      </div>
    </div>
  );
}

export default App;

