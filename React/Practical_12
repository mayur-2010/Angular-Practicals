// Practical 12: To-Do List – Add, edit, mark complete, and delete tasks using React

// App.jsx
import React, { useState } from 'react';
import './App.css';

function App() {
  const [tasks, setTasks] = useState([
    { id: 1, text: 'Learn Angular Component Lifecycle', completed: true },
    { id: 2, text: 'Build React To-Do Application', completed: false },
    { id: 3, text: 'Prepare for FSD-III Practical Exam', completed: false }
  ]);
  const [inputText, setInputText] = useState('');
  const [editingId, setEditingId] = useState(null);
  const [editText, setEditText] = useState('');

  // Add new task
  const addTask = (e) => {
    e.preventDefault();
    if (!inputText.trim()) return;
    const newTask = {
      id: Date.now(),
      text: inputText.trim(),
      completed: false
    };
    setTasks([...tasks, newTask]);
    setInputText('');
  };

  // Toggle complete
  const toggleComplete = (id) => {
    setTasks(
      tasks.map((task) =>
        task.id === id ? { ...task, completed: !task.completed } : task
      )
    );
  };

  // Start editing
  const startEditing = (task) => {
    setEditingId(task.id);
    setEditText(task.text);
  };

  // Save edit
  const saveEdit = (id) => {
    if (!editText.trim()) return;
    setTasks(
      tasks.map((task) =>
        task.id === id ? { ...task, text: editText.trim() } : task
      )
    );
    setEditingId(null);
    setEditText('');
  };

  // Cancel edit
  const cancelEdit = () => {
    setEditingId(null);
    setEditText('');
  };

  // Delete task
  const deleteTask = (id) => {
    setTasks(tasks.filter((task) => task.id !== id));
  };

  const completedCount = tasks.filter((t) => t.completed).length;

  return (
    <div className="todo-app">
      <div className="todo-card">
        <header className="todo-header">
          <h2>Task Manager / To-Do List</h2>
          <p className="summary">
            {completedCount} of {tasks.length} tasks completed
          </p>
        </header>

        {/* Add Task Form */}
        <form onSubmit={addTask} className="add-task-form">
          <input
            type="text"
            placeholder="Add a new task..."
            value={inputText}
            onChange={(e) => setInputText(e.target.value)}
          />
          <button type="submit" className="add-btn">
            + Add
          </button>
        </form>

        {/* Tasks List */}
        <ul className="task-list">
          {tasks.length === 0 ? (
            <li className="empty-state">No tasks available. Add one above!</li>
          ) : (
            tasks.map((task) => (
              <li
                key={task.id}
                className={`task-item ${task.completed ? 'completed' : ''}`}
              >
                {editingId === task.id ? (
                  <div className="edit-box">
                    <input
                      type="text"
                      value={editText}
                      onChange={(e) => setEditText(e.target.value)}
                      autoFocus
                    />
                    <div className="edit-actions">
                      <button
                        onClick={() => saveEdit(task.id)}
                        className="save-btn"
                      >
                        ✓
                      </button>
                      <button onClick={cancelEdit} className="cancel-btn">
                        ✕
                      </button>
                    </div>
                  </div>
                ) : (
                  <>
                    <div className="task-content">
                      <input
                        type="checkbox"
                        checked={task.completed}
                        onChange={() => toggleComplete(task.id)}
                        id={`task-${task.id}`}
                      />
                      <label htmlFor={`task-${task.id}`}>{task.text}</label>
                    </div>
                    <div className="task-buttons">
                      <button
                        onClick={() => startEditing(task)}
                        className="icon-btn edit"
                        title="Edit task"
                      >
                        ✎
                      </button>
                      <button
                        onClick={() => deleteTask(task.id)}
                        className="icon-btn delete"
                        title="Delete task"
                      >
                        🗑
                      </button>
                    </div>
                  </>
                )}
              </li>
            ))
          )}
        </ul>
      </div>
    </div>
  );
}

export default App;

