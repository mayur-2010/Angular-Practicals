    skills: [
      'Python',
      'HTML',
      'CSS',
      'JavaScript',
      'Java',
      'SQL',
      'MongoDB',
      'AI & ML',
      'Data Analytics'
    ],

    projects: [
      {
        name: 'Smart Queue Management System',
        description: 'A smart system for managing queues using online tokens and real-time queue tracking.',
        link: 'https://github.com/'
      },
      {
        name: 'AI Insight',
        description: 'An AI-based project designed to provide intelligent insights using machine learning techniques.',
        link: 'https://github.com/'
      },
      {
        name: 'Crowd Pressure Index Prediction',
        description: 'A machine learning project that predicts crowd pressure and provides risk levels such as Safe, Moderate and Critical.',
