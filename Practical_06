//app.html
<div class="portfolio-container">

  <header>
    <h1>{{ student.name }}</h1>
    <h3>{{ student.title }}</h3>
  </header>

  <section class="bio">
    <h2>About Me</h2>
    <p>{{ student.bio }}</p>
  </section>

  <section class="skills">
    <h2>Skills</h2>

    <ul>
      <li *ngFor="let skill of student.skills">
        {{ skill }}
      </li>
    </ul>
  </section>

  <section class="projects">
    <h2>Projects</h2>

    <div *ngFor="let project of student.projects" class="project-card">

      <h3>{{ project.name }}</h3>

      <p>{{ project.description }}</p>

      <a
        [href]="project.link"
        target="_blank"
        rel="noopener noreferrer">
        View Project
      </a>

    </div>
  </section>

  <section class="contact">
    <h2>Contact</h2>

    <ul>
      <li>
        Email:
        <a [href]="'mailto:' + student.contact.email">
          {{ student.contact.email }}
        </a>
      </li>

      <li>
        Phone: {{ student.contact.phone }}
      </li>

      <li>
        LinkedIn:
        <a
          [href]="student.contact.linkedin"
          target="_blank"
          rel="noopener noreferrer">
          Profile
        </a>
      </li>

      <li>
        GitHub:
        <a
          [href]="student.contact.github"
          target="_blank"
          rel="noopener noreferrer">
          Repositories
        </a>
      </li>
    </ul>
  </section>

</div>

//app.css
.portfolio-container {
  max-width: 800px;
  margin: 30px auto;
  padding: 20px;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  color: #333;
}

header {
  text-align: center;
  padding: 30px;
  background-color: #2c3e50;
  color: white;
  border-radius: 8px;
}

header h1 {
  margin-bottom: 0;
  font-size: 2.8rem;
}

header h3 {
  margin-top: 8px;
  font-weight: normal;
}

section {
  margin-top: 30px;
}

section h2 {
  color: #2c3e50;
  border-bottom: 2px solid #3498db;
  padding-bottom: 8px;
}

.skills ul,
.contact ul {
  list-style-type: none;
  padding: 0;
}

.skills li,
.contact li {
  background-color: #ecf0f1;
  display: inline-block;
  padding: 8px 12px;
  margin: 5px;
  border-radius: 4px;
}

.project-card {
  background-color: #f9f9f9;
  border-left: 4px solid #3498db;
  padding: 15px;
  margin-bottom: 15px;
  border-radius: 4px;
}

.project-card h3 {
  margin-top: 0;
  color: #2c3e50;
}

.project-card a {
  color: #2980b9;
  text-decoration: none;
}

.project-card a:hover {
  text-decoration: underline;
}

.contact li {
  display: block;
  margin: 8px 0;
}